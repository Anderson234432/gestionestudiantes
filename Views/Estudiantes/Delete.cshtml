@model GestionEstudiantes.Models.Estudiante
@{
    ViewData["Title"] = "Eliminar estudiante";
}

<h1 class="h3">Eliminar estudiante</h1>
<hr />

<div class="alert alert-warning">
    ¿Seguro que deseas eliminar a <strong>@Model.NombreCompleto</strong> (@Model.Matricula)? Esta acción no se puede deshacer.
</div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Correo)</dt>
    <dd class="col-sm-9">@Model.Correo</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Carrera)</dt>
    <dd class="col-sm-9">@Model.Carrera</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
